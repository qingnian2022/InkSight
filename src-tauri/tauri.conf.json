{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inksight",
  "version": "1.1.0",
  "identifier": "com.iife.md-rust",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Inksight",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#f4f5f5"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1QUI5QkUxNkVDQUNDQzYKUldUR3pNcHU0WnVycFlybFJRWUhoclNKQTJGZTFpMURNaWYyemNjL0ozdEV1cU5lZzdKM1JXUVQK",
      "endpoints": [
        "https://gitee.com/hao-zhangjian/Inksight/raw/master/updates/latest.json"
      ]
    }
  }
}
